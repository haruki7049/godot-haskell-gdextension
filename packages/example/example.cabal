cabal-version: 3.0
name: example
version: 4.1.0.0
build-type: Custom

custom-setup
  setup-depends:
    Cabal,
    base,
    shelly,

common warnings
  ghc-options: -Wall

foreign-library gdext-example
  import: warnings
  type: native-shared
  hs-source-dirs: lib
  other-modules: FLib
  build-depends:
    base,
    godot-haskell-gdextension,

  default-language: GHC2021
