cabal-version: 3.0
name: example
version: 4.1.0.0
build-type: Custom

custom-setup
  setup-depends:
    Cabal,
    base,
    directory,
    filepath,

common warnings
  ghc-options: -Wall -threaded

foreign-library gdext-example
  import: warnings
  type: native-shared
  c-sources: cbits/flib.c
  hs-source-dirs: lib
  other-modules: FLib
  build-depends:
    base,
    godot-haskell-gdextension,

  default-language: GHC2021
